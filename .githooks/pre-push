#!/bin/sh
dir=$(dirname "$0")
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *) range="$local_sha --not --remotes" ;;
  esac

  for c in $(git rev-list $range); do
    bad=$(git diff-tree --no-commit-id --name-only -r --diff-filter=ACMR "$c" | sh "$dir/env-guard.sh")
    if [ -n "$bad" ]; then
      echo "PUSH BLOCKED: commit $(git rev-parse --short "$c") adds env files:" >&2
      echo "$bad" | sed 's/^/  /' >&2
      status=1
    fi
  done

  bad=$(git ls-tree -r --name-only "$local_sha" | sh "$dir/env-guard.sh")
  if [ -n "$bad" ]; then
    echo "PUSH BLOCKED: $local_ref still tracks env files:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    status=1
  fi
done

[ $status -ne 0 ] && echo "Remove them from history (git rm --cached, then rewrite the commit) before pushing." >&2
exit $status
