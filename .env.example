# supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Project Settings → API Keys). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Publicly accessible URL for the logo used in emails (must be reachable by email clients)
NEXT_PUBLIC_LOGO_URL=

# database connection string, only used to apply migrations (npm run db:push)
DATABASE_URL=

# github oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL for judge portal links in emails (defaults to https://dashboard.revolutionuc.com/judgingportal)
NEXT_PUBLIC_JUDGING_PORTAL_URL=

# resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=